{
    "name": "k8sdockside-descheduler-plugin",
    "version": "1.0.0",
    "private": true,
    "description": "The K8s Dockside plugin for the Kubernetes descheduler: what it is doing, what it has evicted, and its policy as forms rather than YAML.",
    "license": "Apache-2.0",
    "author": "K8s Dockside",
    "repository": {
        "type": "git",
        "url": "https://github.com/k8sdockside/descheduler"
    },
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "k8sdockside-plugin build",
        "watch": "k8sdockside-plugin watch",
        "preview": "node scripts/preview.mjs",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "check": "npm run typecheck && npm run test && k8sdockside-plugin check"
    },
    "dependencies": {
        "js-yaml": "^5.4.2"
    },
    "devDependencies": {
        "@k8sdockside/plugin-sdk": "^1.0.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.2"
    }
}
